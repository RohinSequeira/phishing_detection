{
  "manifest_version": 3,
  "name": "Email Phishing Detector",
  "version": "1.0",
  "description": "Detects potential phishing attempts in emails using AI-powered analysis",
  "permissions": [
    "activeTab",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "*://mail.google.com/*",
    "*://*.outlook.live.com/*",
    "*://*.outlook.office.com/*",
    "*://mail.yahoo.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "384435032233-evh45312eeed6ale5u2le1vbo19pbdi3.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "*://*.outlook.live.com/*",
        "*://*.outlook.office.com/*",
        "*://mail.yahoo.com/*"
      ],
      "js": ["config.js", "content.js"]
    }
  ]
} 